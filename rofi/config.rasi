configuration {
    modi: "window,drun,run,calc";
    font: "jetbrains mono 14";
    show-icons: true;
    icon-theme: "Papirus";
    
    display-drun: " Поиск";
    display-calc: " Калькулятор";
    display-window: " Окна";
    display-run: " Запустить";
    
    terminal: "kitty";
    drun-display-format: "{name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    sidebar-mode: true;
}

@theme "/dev/null"

* {
    bg: rgba(39, 46, 51, 1);
    bg-alt: rgba(44, 52, 59, 1);
    fg: rgba(211, 198, 170, 1);
    fg-black: rgba(211, 198, 170, 0.4);
    accent: rgba(136, 130, 117, 1); // yellowd-color
    red:     rgba(230, 126, 128, 1);
    redd:    rgba(179, 95, 96, 1);
    green:   rgba(167, 192, 128, 1);
    yellow:  rgba(219, 188, 127, 1);
    yellowd: rgba(136, 130, 117, 1);
    blue:    rgba(127, 187, 179, 1);
    magenta: rgba(214, 153, 182, 1);
    cyan:    rgba(131, 192, 146, 1);

    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 740px;
    height: 788px;
    background-color: @bg;
    border: 4px;
    border-color: @accent;
    border-radius: 10px;
}

inputbar {
    children: [prompt, entry];
    background-color: @bg;
    margin: 10px;
    border-radius: 8px;
}

prompt {
    padding: 12px;
    background-color: @accent;
    text-color: @bg;
}

entry {
    margin: 12px;
}

listview {
    padding: 4px;
    columns: 3;
    fixed-height: false;
}

element {
    padding: 10px;
    spacing: 10px;
    border-radius: 12px;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}

element selected {
    background-color: @accent;
    text-color: @bg;
}

element-icon {
    size: 32px;
}

button{
    background-color: @bg;
    text-color:       @fg-black;
    border-radius:    8px 8px 0px 0px; /* Скругляем только верх, чтобы было похоже на вкладку */
    margin: 0px 4px;
}

button selected {
  background-color: @bg;
  text-color: @fg;
  /* Можно добавить скругление сверху, чтобы было похоже на вкладку браузера */
  border-radius: 14px 14px 0px 0px;
}
