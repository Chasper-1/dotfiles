{
  "mpris": {
    //"player": "spotify",
    //"player": "chromium",
    //"player": "youtui",
    //"player": "cmus",
    "player": "yamusic-tui",
    "format": "{artist} — {title} | [{album}] | {player_icon} | [{length}]",
    "format-paused": "{artist} — {title} | [{album}] | {status_icon} | [{position}]",
    "album-len": 16,
    "title-len": 20,
    "artist-len": 20,
    "tooltip-format": "Исполнитель — {artist} | Название — {title}\nАльбом — {album}\n{length} — Длинна песни | {position} — Время сейчас\n{player} — Имя медиаплеера",
    "player-icons": {
      "default": ""
    },
    "status-icons": {
      "paused": ""
    }
  },
  "hyprland/workspaces": {
    "all-outputs": false,
    "format": "{name}"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "bluetooth": {
    "format": "󰂯",
    "format-off": "󰂲",
    "format-connected": "󰂯 {icon}Device",
    "format-connected-battery": "󰂯 Device {icon}{device_battery_percentage}%",
    // "format-device-preference": [ "device1", "device2" ], // preference list deciding the displayed device
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "bluetoothctl power on",
    "on-click-right": "bluetoothctl power off",
    "on-click-middle": "blueman-manager",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },
  "wireplumber": {
    "format": "{icon}  {volume}%",
    "format-muted": "",
    "format-bluetooth": "{icon} {volume}% 󰂯 {format_source}",
    "format-bluetooth-muted": " {icon}󰂯 {format_source}",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "on-click-right": "pavucontrol",
    "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle"
  },
  "wireplumber#source": {
    "node-type": "Audio/Source",
    "format": "󰍬 {volume}%",
    "format-muted": "󰍭",
    "on-click-right": "pavucontrol",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
  },
  "network": {
    "format-wifi": "{icon} {essid}",
    "format-disconnected": "󰌙 Нет сети",
    "format-ethernet": "󰈀 Ethernet",
    "format-alt": "{icon} ( {bandwidthDownBits} |  {bandwidthUpBits})",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format": "{ipaddr} | {netmask} | {frequency}",
    "tooltip-format-disconnected": "Нет подключения",
    "on-click-right": "nm-connection-editor",
    "interval": 1
  },
  //"custom/cpu": {
  //  "return-type": "json",
  //  "restart-interval": 1,
  //  "exec": "tail -F /tmp/eww_backend.fifo | grep --line-buffered '^\\[CPU\\]' | cut -d' ' -f2-",
  //  "format": "{}"
  //},
  "cpu": {
    "format": " {usage}%",
    "tooltip": true,
    "interval": 1
  },
  //"custom/memory": {
  //  "return-type": "json",
  //  "restart-interval": 1,
  //  "exec": "~/.local/bin/eww_backend --memory",
  //  "format": "{}"
  //},
  "memory": {
    "format": " {used}GiB",
    "tooltip": true,
    "tooltip-format": "RAM: {avail}GiB | {total}GiB\nSWAP: {swapAvail}GiB | {swapTotal}GiB",
    "format-alt": " {swapUsed}GiB",
    "interval": 3
  },
  "custom/disk": {
      "return-type": "json",
      "restart-interval": 1,
      "exec": "~/.local/bin/eww_backend --disks",
      "format": "{}"
  },
  "custom/temp": {
      "return-type": "json",
    "restart-interval": 1,
    "exec": "~/.local/bin/eww_backend --temp",
    "format": "{}"
  },
  "hyprland/language": {
    "format": "{}",
    "format-en": "En",
    "format-ru": "Ru",
    "on-click": "hyprctl switchxkblayout by-tech-gaming-keyboard next"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-full": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-alt": "{time}  {icon}",
    "format-icons": ["", "", "", "", ""]
  },
  "custom/clock": {
      "exec": "~/.local/bin/eww_backend --clock",
      "restart-interval": 1,
      "return-type": "json",
      "format": "{}"
  },
  //"clock": {
  //  "format": "{:%H:%M | %a %e %b}",
  //  "tooltip-format": "<big>{:%Y-%m-%d}</big>\n<tt><small>{calendar}</small></tt>",
  //  "format-alt": "{:%H:%M | %d-%m-%Y}"
  //},
  "tray": {
    "icon-size": 21,
    "spacing": 10
  },
  "custom/aur": {
    "format": "{}",
    "exec": "/home/kasper/Документы/code/скрипты/checkupdates-aur.sh",
    "restart-interval": 3600,
    "return-type": "json",
    "on-click": "/home/kasper/Документы/code/скрипты/checkupdates-aur.sh --list | rofi -dmenu -i -p 'Обновления' -theme-str 'window { width: 600px; height: 772px;} listview { columns: 1; lines: 20; } element-text { wrap: true; margin: 12px 0px 12px -36px;} element { orientation: horizontal; padding: 0px;}'",
    "on-click-right": "/home/kasper/Документы/code/скрипты/checkupdates-aur"
  },
  "custom/date-timer": {
    "format": "{}",
    "exec": "~/.local/bin/eww_backend --timer",
    "restart-interval": 1,
    "return-type": "json"
  },
  "custom/mouse": {
    "format": "󰍽 {}",
    "exec": "~/.local/bin/mouse",
    "restart-interval": 1,
    "return-type": "json"
  }
}
