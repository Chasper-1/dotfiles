{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "",
    "height": 12,
    "width": 24,
    "padding": {
      "top": 0,
      "left": 1
    }
  },
  "display": {
    "separator": "\u001b[90m ▐ "
  },
  "modules": [
    {
      "type": "os",
      "key": "",
      "keyColor": "94",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": "",
      "keyColor": "39"
    },
    {
      "type": "packages",
      "key": "󰏖",
      "keyColor": "33"
    },
    {
      "type": "shell",
      "key": "",
      "keyColor": "94",
      "format": "{1}"
    },
    {
      "type": "terminal",
      "key": "",
      "keyColor": "39",
      "format": "{1}"
    },
    "break",

    {
      "type": "wm",
      "key": "󰕮",
      "keyColor": "34"
    },
    {
      "type": "wmtheme",
      "key": "",
      "keyColor": "33"
    },
    {
      "type": "icons",
      "key": "",
      "keyColor": "93"
    },

    "break",
    {
      "type": "host",
      "key": "󰌢",
      "keyColor": "92"
    },
    {
      "type": "display",
      "key": "󰹑",
      "keyColor": "32"
    },
    {
      "type": "cpu",
      "key": "󰍛",
      "keyColor": "96"
    },
    {
      "type": "gpu",
      "key": "󰢮",
      "keyColor": "96"
    },
    {
      "type": "memory",
      "key": "",
      "keyColor": "36"
    },
    {
      "type": "disk",
      "key": "󰋊",
      "keyColor": "33",
      "format": "{1} ({3})"
    },

    "break",
    {
      "type": "uptime",
      "key": "󱤦",
      "keyColor": "35",
      "format": "Старт был: {2} часов, {3} минут, {4} секунд назад"
    },
    {
      "type": "command", // Сколько дней системе, с момента установки
      "key": "󱑒",
      "keyColor": "31",
      "text": "/home/kasper/Документы/code/скрипты/time-my-pc.sh"
    },
    "break",
    "colors"
  ]
}
