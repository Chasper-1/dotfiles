// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  //Трогал

  //"proxy": "socks5://220.121.193.144:1082",
  "show_edit_predictions": true,
  "status_bar": {
    "active_language_button": true,
    "line_endings_button": true,
    "show_active_file": true
  },
  "tab_bar": {
    "show_tab_bar_buttons": true
  },
  "focus_follows_mouse": {
    "enabled": false,
    "debounce_ms": 250
  },
  "use_system_window_tabs": false,
  "window_decorations": "client",
  "fullscreen_mode": "native",
  "pane_split_direction_horizontal": "down",
  "pane_split_direction_vertical": "right",
  "close_panel_on_toggle": false,
  "active_pane_modifiers": {
    "border_size": 0.0,
    "inactive_opacity": 1.0
  },
  "zoomed_padding": false,
  "window_title_format": "${projectName}${separator}${fileName}",
  "diff_view_style": "unified",
  "server_url": "https://zed.dev",
  "context_servers": {

  },

  "languages": {
    "Markdown": {
      "soft_wrap": "editor_width"
    }
  },

  "git": {
    "blame": {
      "show_avatar": true
    },
    "inline_blame": {
      "enabled": false
    }
  },
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "button": true,
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "language_models": {
    "opencode": {
      "show_zen_models": false,
      "show_go_models": false
    },
    "openai_compatible": {

    },
    "llama.cpp": {
      "api_url": "http://127.0.0.1:8080"
    },
    "ollama": {
      "context_window": 30000,
      "api_url": "http://localhost:11434",
    },
  },
  "edit_predictions": {
    "mode": "subtle",
    "provider": "zed",
  },
  "terminal": {
    "env": {
      "http_proxy": "http://127.0.0.1:2080",
      "https_proxy": "http://127.0.0.1:2080",
      "all_proxy": "socks5h://127.0.0.1:2080",
    },
  },
  "agent": {
    "single_file_review": true,
    "play_sound_when_agent_done": "never",
    "show_merge_conflict_indicator": true,
    "show_turn_stats": true,
    "use_modifier_to_send": false,
    "max_content_width": 1500.0,
    "default_height": 327.0,
    "default_width": 640.0,
    "auto_compact": {
      "enabled": true
    },
    "message_editor_min_lines": 4,
    "thinking_display": "preview",
    "notify_when_agent_waiting": "never",
    "dock": "right",
    "profiles": {
      "plan": {
        "name": "plan",
        "tools": {
          "list_directory": true,
          "read_file": true,
          "skill": true
        },
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "default_profile": "plan",
    "default_model": {
      "enable_thinking": false,
      "provider": "llama.cpp",
      "model": "gemma-4-E4B-it-Q5_K_S",
    },
    "model_parameters": [],
  },
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "mode": "build",
        "effort": "high",
        "model": "opencode/deepseek-v4.1-flash-free"
      },
      "type": "registry"
    },
    "pi-acp": {
      "default_config_options": {
        "model": "llama-cpp/Qwen3.8-4B-Q5_K_M",
        "thought_level": "medium"
      },
      "type": "registry"
    },
    "gemini": {
      "default_mode": "default",
      "type": "registry"
    }
  },
  "tabs": {
    "file_icons": true,
    "git_status": false,
  },
  "title_bar": {
    "show_branch_status_icon": false,
    "show_worktree_name": true,
    "show_project_items": true,
    "show_onboarding_banner": false,
    "show_sign_in": true,
    "show_user_menu": true,
    "show_user_picture": false,
    "show_menus": false,
    "show_branch_name": true,
  },
  "ui_font_family": ".ZedSans",
  "buffer_font_family": "JetBrains Mono",
  "auto_update_extensions": {
    "dockerfile": true,
    "qml": true,
    "scss": true,
    "html": true,
    "lua": true,
    "catppuccin": false,
  },
  "git_panel": {
    "tree_view": true,
    "dock": "left",
  },
  "restore_on_startup": "last_session",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "soft_wrap": "editor_width",
  "bottom_dock_layout": "contained",
  //"git_status": "true",
  //"activate_on_close": "neighbour",
  //"hour_format": "hour24",
  "preview_tabs": {
    "enable_preview_from_project_panel": true,
    "enable_preview_from_multibuffer": true,
    "enable_preview_multibuffer_from_code_navigation": false,
    "enable_preview_file_from_code_navigation": true,
    "enabled": true,
    "enable_preview_from_file_finder": true,
    "enable_keep_preview_on_code_navigation": false,
  },
  //Не трогал
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "dark",
    "light": "GitHub Dark Default",
    "dark": "Everforest Dark Hard (regular)",
  },
}
