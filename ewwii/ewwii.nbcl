# Wayland Window Definition
Window "top" {
    monitor = 0
    geometry = {
      x = "0%"
      y = "8px"
      width = "99%"
      height = "30px"
      anchor = "top center"
    }
    exclusive = true

    Greeter { 
        name = "Bob"
    } 
}

component Greeter (name) {
  Box {
    orientation = "horizontal"
    halign = "center"

    Button {
      onclick = "notify-send 'Hello' 'Hello, ${name}'"
      label = "Greet"
    }
  }
}