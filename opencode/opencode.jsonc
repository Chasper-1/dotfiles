{
  "$schema": "https://opencode.ai/config.json",
  "permission": { "read": "allow" },
  "agent": {
    "build": {
      "mode": "all",
      "temperature": 0.25,
    },
    "plan": {
      "temperature": 0.6,
      "tools": {
        "edit": false,
        "write": false,
        "bash": false,
      },
    },
    "writer-manager": {
      "temperature": 0.25,
      "subagents": ["plot-architect", "ghostwriter", "lore-critic"],
    },
  },
  "server": {
    "port": 7756,
    "hostname": "127.0.0.1",
    "mdns": false,
    "mdnsDomain": "myproject.local",
    "cors": ["http://localhost:5173"],
  },
}
